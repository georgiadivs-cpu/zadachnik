POSTGRES_DB=zadachnik
POSTGRES_USER=zadachnik
POSTGRES_PASSWORD=zadachnik
POSTGRES_PORT=5433

# Backup (отдельный диск, age-ключ с правами 0600)
BACKUP_DIR=/Volumes/ZadachnikBackup/zadachnik
BACKUP_AGE_IDENTITY=/etc/zadachnik/backup.key
BACKUP_AGE_RECIPIENT=
BACKUP_PG_DUMP=/opt/homebrew/opt/libpq/bin/pg_dump
BACKUP_PG_RESTORE=/opt/homebrew/opt/libpq/bin/pg_restore
